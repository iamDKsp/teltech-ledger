# ==============================================================================
# TELTECH LEDGER - CONFIGURAÇÃO DE AMBIENTE DOCKER / PORTAINER
# ==============================================================================

# Porta pública do sistema no navegador (Ex: http://192.168.10.20:4500 ou 7080)
WEB_PORT=4500

# Chave secreta para assinatura dos tokens JWT (gere uma string aleatória e segura)
JWT_SECRET=teltech_super_secret_jwt_key_troque_em_producao_2026

# Credenciais do Banco de Dados PostgreSQL interno
POSTGRES_USER=teltech
POSTGRES_PASSWORD=teltech_segura_2026!
POSTGRES_DB=teltech_ledger

# Chave AES-256 (64 caracteres hexadecimais) usada para criptografar a sessão
# WhatsApp no PostgreSQL. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Defina antes de conectar o número; preserve a mesma chave em todos os deploys.
WHATSAPP_SESSION_KEY=
