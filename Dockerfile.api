# ==========================================
# Teltech Ledger - API Backend Dockerfile
# ==========================================
FROM node:22-bookworm-slim AS base

# Install pnpm globally
RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Set environment
ENV NODE_ENV=production
ENV PORT=5000

# Copy workspace files
COPY package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY scripts/ ./scripts/
COPY artifacts/ ./artifacts/

# Patch pnpm-workspace.yaml for Docker:
# - disable minimumReleaseAge (blocks packages published < 1 day ago)
# - remove esbuild version override that may not exist
# - remove stripe-replit-sync from minimumReleaseAgeExclude
RUN sed -i 's/minimumReleaseAge: 1440/minimumReleaseAge: 0/' pnpm-workspace.yaml && \
    sed -i '/^  esbuild: "0\.27\.3"/d' pnpm-workspace.yaml && \
    sed -i '/stripe-replit-sync/d' pnpm-workspace.yaml && \
    sed -i "/'@replit\/\*'/d" pnpm-workspace.yaml

# Install dependencies (no lockfile - generate fresh on Linux)
RUN pnpm install --no-frozen-lockfile

# Build api-server
RUN pnpm --filter @workspace/api-server run build

# Create directory for file uploads
RUN mkdir -p /app/public/uploads

# Copy entrypoint script
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Expose API port
EXPOSE 5000

# Run entrypoint script
ENTRYPOINT ["/app/docker-entrypoint.sh"]
