# ==========================================
# Teltech Ledger - Web Frontend Dockerfile
# Multi-stage: Build with Node 22, Serve with Nginx Alpine
# ==========================================

# ─── Stage 1: Builder ──────────────────────
FROM node:22-bookworm-slim AS builder

RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Copy monorepo configuration and packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY scripts/ ./scripts/
COPY artifacts/ ./artifacts/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build teltech-ledger frontend SPA
ENV NODE_ENV=production
RUN pnpm --filter @workspace/teltech-ledger run build

# ─── Stage 2: Production Nginx ─────────────
FROM nginx:alpine AS runner

# Remove default Nginx site
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled SPA from builder stage
COPY --from=builder /app/artifacts/teltech-ledger/dist/public /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose HTTP port
EXPOSE 80

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
