{
  "expo": {
    "name": "Teltech Ledger",
    "slug": "teltech-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "teltech",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111113"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.teltech.ledger",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID para login rápido no Teltech Ledger"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111113"
      },
      "package": "br.com.teltech.ledger"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-haptics",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
